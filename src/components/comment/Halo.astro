---
import { commentConfig } from "@/config/commentConfig";
import { haloConfig } from "@/config/haloConfig";

interface Props {
	postName: string;
	/** 评论目标类型：Post（文章）或 SinglePage（独立页面/留言板等） */
	kind?: "Post" | "SinglePage";
}

const { postName, kind = "Post" } = Astro.props;
const apiUrl = commentConfig.halo?.apiUrl || haloConfig.apiUrl;
const subjectKind = kind;
---

<div
  class="halo-comments"
  data-halo-comments
  data-api-url={apiUrl}
  data-post-name={postName}
>
  <div class="halo-comments-list" data-comments-list>
    <p class="text-sm text-50">正在加载评论...</p>
  </div>

  <form class="halo-comment-form" data-comment-form>
    <div class="grid gap-3 md:grid-cols-3">
      <label class="flex flex-col gap-1 text-sm text-50">
        昵称
        <input name="displayName" required maxlength="64" autocomplete="name" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-50">
        邮箱（可选）
        <input name="email" type="email" autocomplete="email" />
      </label>
      <label class="flex flex-col gap-1 text-sm text-50">
        网站（可选）
        <input name="website" type="url" autocomplete="url" />
      </label>
    </div>
    <label class="mt-3 flex flex-col gap-1 text-sm text-50">
      评论内容
      <textarea name="raw" required maxlength="5000" rows="4"></textarea>
    </label>
    <div class="mt-3 flex items-center gap-3">
      <button type="submit" class="btn-regular px-4 py-2">发表评论</button>
      <span class="text-sm text-50" data-comment-status aria-live="polite"></span>
    </div>
  </form>
</div>

<style>
	.halo-comments {
		display: grid;
		gap: 1.25rem;
	}

	.halo-comment-form {
		border-top: 1px solid var(--line-divider);
		padding-top: 1.25rem;
	}

	.halo-comment-form input,
	.halo-comment-form textarea {
		border: 1px solid var(--line-divider);
		border-radius: 0.75rem;
		background: var(--card-bg);
		color: var(--font-color);
		padding: 0.625rem 0.75rem;
		outline: none;
	}

	.halo-comment-form input:focus,
	.halo-comment-form textarea:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
	}

	.halo-comment-item {
		border-bottom: 1px dashed var(--line-divider);
		padding-bottom: 1rem;
	}

	.halo-comment-item:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.halo-comment-replies {
		border-left: 2px solid var(--line-divider);
		margin: 0.75rem 0 0 1rem;
		padding-left: 1rem;
	}
</style>

<script is:inline define:vars={{ apiUrl, postName, subjectKind }}>
	const commentsApi = `${apiUrl}/apis/api.halo.run/v1alpha1/comments`;

	function escapeHtml(value) {
		return String(value ?? "")
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#039;");
	}

	function formatDate(value) {
		if (!value) return "";
		const date = new Date(value);
		return Number.isNaN(date.getTime()) ? "" : date.toLocaleString();
	}

	function ownerName(comment) {
		return comment?.spec?.owner?.displayName || "访客";
	}

	function renderComment(comment) {
		const owner = escapeHtml(ownerName(comment));
		const date = escapeHtml(formatDate(comment?.metadata?.creationTimestamp));
		const body = comment?.spec?.content || escapeHtml(comment?.spec?.raw || "");
		const replies = comment?.replies?.items || [];
		const repliesHtml = replies.length
			? `<div class="halo-comment-replies">${replies.map(renderReply).join("")}</div>`
			: "";
		return `<article class="halo-comment-item"><div class="flex items-center justify-between gap-3"><strong class="text-90">${owner}</strong><time class="text-xs text-50">${date}</time></div><div class="mt-2 text-75 prose dark:prose-invert max-w-none">${body}</div>${repliesHtml}</article>`;
	}

	function renderReply(reply) {
		const owner = escapeHtml(reply?.spec?.owner?.displayName || "访客");
		const date = escapeHtml(formatDate(reply?.metadata?.creationTimestamp));
		const body = reply?.spec?.content || escapeHtml(reply?.spec?.raw || "");
		return `<div class="mb-3 last:mb-0"><div class="flex items-center justify-between gap-3"><strong class="text-sm text-90">${owner}</strong><time class="text-xs text-50">${date}</time></div><div class="mt-1 text-sm text-75 prose dark:prose-invert max-w-none">${body}</div></div>`;
	}

	function getElements() {
		const root = document.querySelector("[data-halo-comments]");
		if (!root) return null;
		return {
			root,
			list: root.querySelector("[data-comments-list]"),
			form: root.querySelector("[data-comment-form]"),
			status: root.querySelector("[data-comment-status]"),
		};
	}

	async function loadComments() {
		const elements = getElements();
		if (!elements) return;
		const params = new URLSearchParams({
			group: "content.halo.run",
			version: "v1alpha1",
			kind: subjectKind,
			name: postName,
			withReplies: "true",
			page: "1",
			size: "50",
			sort: "creationTimestamp,asc",
		});
		try {
			const response = await fetch(`${commentsApi}?${params}`, {
				headers: { Accept: "application/json" },
			});
			if (!response.ok) throw new Error(`HTTP ${response.status}`);
			const result = await response.json();
			const comments = result.items || [];
			elements.list.innerHTML = comments.length
				? comments.map(renderComment).join("")
				: '<p class="text-sm text-50">还没有评论，来留下第一条吧。</p>';
		} catch (error) {
			elements.list.innerHTML = '<p class="text-sm text-50">评论暂时无法加载。</p>';
			console.error("[Halo] failed to load comments", error);
		}
	}

	function escapeComment(value) {
		return escapeHtml(value).replaceAll("\n", "<br />");
	}

	function bindForm() {
		const elements = getElements();
		if (!elements?.form || elements.form.dataset.bound === "true") return;
		elements.form.dataset.bound = "true";
		elements.form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const form = new FormData(elements.form);
			const displayName = String(form.get("displayName") || "").trim();
			const raw = String(form.get("raw") || "").trim();
			if (!displayName || !raw) return;
			elements.status.textContent = "正在提交...";
			const body = {
				subjectRef: {
					group: "content.halo.run",
					version: "v1alpha1",
					kind: subjectKind,
					name: postName,
				},
				owner: {
					email: String(form.get("email") || "").trim() || null,
					displayName,
					website: String(form.get("website") || "").trim() || null,
				},
				raw,
				content: `<p>${escapeComment(raw)}</p>`,
				allowNotification: false,
				hidden: false,
			};
			try {
				const response = await fetch(commentsApi, {
					method: "POST",
					headers: { Accept: "application/json", "Content-Type": "application/json" },
					body: JSON.stringify(body),
				});
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				elements.form.reset();
				elements.status.textContent = "评论已提交，等待审核或刷新后查看。";
				await loadComments();
			} catch (error) {
				elements.status.textContent = "提交失败，请稍后重试。";
				console.error("[Halo] failed to submit comment", error);
			}
		});
	}

	function initHaloComments() {
		bindForm();
		loadComments();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHaloComments, { once: true });
	} else {
		initHaloComments();
	}
	document.addEventListener("swup:contentReplaced", initHaloComments);
</script>
